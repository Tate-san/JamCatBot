DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one guild for faster development.
# DISCORD_GUILD_ID=
DATABASE_URL=data/jamcat.sqlite
NODE_ENV=development
LOG_LEVEL=info
REGISTER_SLASH_COMMANDS=true
# Optional binary overrides:
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=/path/to/ffmpeg

# Optional Spotify API credentials. Recommended for large playlists/albums
# and to avoid Spotify token scraping warnings.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_TOP_TRACKS_COUNTRY=US
